#!/bin/bash
set -e

sh /app/lib/message.sh light "PHP 8.5.X"

apt_update_retry() {
  local tries=3
  local delay=5
  for ((i=1; i<=tries; i++)); do
    if apt update; then
      return 0
    fi
    if [ "$i" -lt "$tries" ]; then
      echo "apt update başarısız, ${delay} sn sonra tekrar deneniyor ($i/$tries)..."
      sleep "$delay"
    fi
  done
  return 1
}

apt_update_retry
apt install -y lsb-release ca-certificates curl

if grep -qi "debian" /etc/os-release; then
  curl -sSLo /tmp/debsuryorg-archive-keyring.deb https://packages.sury.org/debsuryorg-archive-keyring.deb
  dpkg -i /tmp/debsuryorg-archive-keyring.deb
  rm -f /tmp/debsuryorg-archive-keyring.deb
  tee /etc/apt/sources.list.d/php.sources >/dev/null <<EOF
Types: deb
URIs: https://packages.sury.org/php/
Suites: $(lsb_release -sc)
Components: main
Signed-By: /usr/share/keyrings/debsuryorg-archive-keyring.gpg
EOF
elif grep -qi "ubuntu" /etc/os-release; then
  apt install -y software-properties-common
  LC_ALL=C.UTF-8 add-apt-repository ppa:ondrej/php -y
fi

apt_update_retry

# Install PHP 8.5 and extensions.
apt install -y php8.5 php8.5-cli php8.5-fpm php8.5-curl php8.5-mbstring php8.5-xml php8.5-zip php8.5-mysql php8.5-gd

if command -v php8.5 >/dev/null 2>&1 && php8.5 -v >/dev/null 2>&1 && php8.5 -r 'echo "OK";' >/dev/null 2>&1; then
    PHP_VER="$(php8.5 -v | head -n 1)"
    echo "Mevcut Sürüm: ${PHP_VER}"
    sh /app/lib/message.sh success "PHP kuruldu ve çalışıyor (${PHP_VER})"
else
    sh /app/lib/message.sh alert "PHP 8.5 kurulamadı veya çalışmıyor"
    exit 1
fi

echo "[.] Kısayol oluşturuluyor -> /app/php "
PHP_BIN="$(command -v php8.5 || command -v php || true)"

if [ -n "$PHP_BIN" ] && [ -x "$PHP_BIN" ]; then
  ln -sf "$PHP_BIN" /app/php
  echo "[+] Bağlantı oluşturuldu: /app/php -> $PHP_BIN"
else
  echo "[-] Sistemde çalışan bir php ikilisi bulunamadı."
  exit 1
fi
