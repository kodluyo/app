#!/bin/bash

# Parametre olarak sürüm al (örnek: 8.5, 8.4, 8.3), verilmezse varsayılan 8.5 kullan
PHP_VERSION="${1:-8.5}"

sh /app/lib/message.sh light "PHP $PHP_VERSION"

INSTALL_DIR="/app/files/php/${PHP_VERSION}"
LINK_PATH="/app/php${PHP_VERSION}"

export DEBIAN_FRONTEND=noninteractive

# Depo ekleme araçları ve paketler
apt-get update
apt-get install -y software-properties-common ca-certificates lsb-release apt-transport-https

# Ondřej Surý PHP deposunu ekle (Ubuntu/Debian)
LC_ALL=C.UTF-8 add-apt-repository -y ppa:ondrej/php
apt-get update

# PHP CLI ve sık kullanılan temel eklentileri kur
apt-get install -y \
    "php${PHP_VERSION}-cli" \
    "php${PHP_VERSION}-common" \
    "php${PHP_VERSION}-curl" \
    "php${PHP_VERSION}-mbstring" \
    "php${PHP_VERSION}-xml" \
    "php${PHP_VERSION}-zip" \
    "php${PHP_VERSION}-mysql" \
    "php${PHP_VERSION}-sqlite3"

# Sistemdeki ikili dosyanın gerçek yolunu bul ve /app altına bağla
PHP_BIN="$(command -v "php${PHP_VERSION}")"
if [ -z "${PHP_BIN}" ]; then
    echo "HATA: php${PHP_VERSION} ikilisi bulunamadı. Sürümü kontrol edin."
    exit 1
fi

mkdir -p "${INSTALL_DIR}/bin"
ln -sf "${PHP_BIN}" "${INSTALL_DIR}/bin/php"

rm -f "${LINK_PATH}" "/app/php"
ln -s "${INSTALL_DIR}/bin/php" "${LINK_PATH}"
ln -s "${INSTALL_DIR}/bin/php" "/app/php"

chmod +x "${LINK_PATH}" "/app/php"

echo "==========================================="
sh /app/lib/message.sh success "Kurulum Tamamlandı php $PHP_VERSION"
echo "Sürüm:   ${PHP_VERSION}"
echo "Hedef:   ${INSTALL_DIR}"
echo "Kısayol: ${LINK_PATH}"
echo "==========================================="
